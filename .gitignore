## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# --- Docker ---
docker-compose.override.yml
.env

# --- PROJECT SPECIFIC (MiniCloudNote) ---
# Bỏ qua thư mục backup và rác hệ thống
_backups/
backup_minio_data/
learning-scratchpad/
*.sql
*.dump

# --- FLUTTER & FRONTEND (MỚI) ---
# Flutter/Dart/Pub
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Bỏ qua thư mục build của Flutter (nằm trong frontend/build)
**/build/

# Android specific (Frontend)
**/android/local.properties
**/android/.gradle
**/android/app/google-services.json

# iOS specific (Frontend)
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/.generated/

# --- BACKEND (.NET) ---
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache
.vs/
Generated\ Files/

# MSTest & NUnit
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Benchmark & Tye
BenchmarkDotNet.Artifacts/
.tye/

# File rác hệ thống khác
*.tmp
*.log
*.tlog
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# JetBrains Rider / Android Studio
.idea/
*.sln.iml

# --- SECURITY & CONFIG ---
# Ignore appsettings.json to protect secrets
**/appsettings.json
**/appsettings.Development.json
**/appsettings.Production.json
# (Mẹo: Bạn nên tạo file appsettings.Example.json và commit nó lên để người khác biết cấu trúc)

# SonarQube generated files
.sonarqube/
.scannerwork/
out/
**/report-task.txt
**/*.pb
**/*.xml
# Giữ lại xml trong source code nếu cần thiết (đã cập nhật đường dẫn mới)
!backend/**/*.xml
!*.csproj
!*.sln

# Android specific (Frontend)
**/android/key.properties